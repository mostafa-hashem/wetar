<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wetar_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E61C1714"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/shortcut_shuffle_short"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Wetar"
            android:textColor="#FFF6EFE6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tap to play"
            android:textColor="#FFA69788"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_prev"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@android:color/transparent"
        android:contentDescription="Previous"
        android:src="@android:drawable/ic_media_previous"
        android:tint="#FFF6EFE6" />

    <ImageButton
        android:id="@+id/widget_play_pause"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@android:color/transparent"
        android:contentDescription="Play or Pause"
        android:src="@android:drawable/ic_media_play"
        android:tint="#FFE69B3A" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@android:color/transparent"
        android:contentDescription="Next"
        android:src="@android:drawable/ic_media_next"
        android:tint="#FFF6EFE6" />
</LinearLayout>
